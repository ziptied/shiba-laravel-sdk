{
    "name": "bentonow/shiba-laravel-sdk",
    "description": "Laravel mail transport and signed webhook receiver for PostShiba.",
    "keywords": [
        "laravel",
        "mail",
        "postshiba",
        "shiba",
        "webhooks"
    ],
    "homepage": "https://app.postshiba.com/docs",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": ">=8.4",
        "illuminate/http": "^13.0",
        "illuminate/mail": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "saloonphp/saloon": "^4.0",
        "yorcreative/laravel-argonaut-dto": "^1.5"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.2",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Bentonow\\ShibaLaravel\\": "src/"
        },
        "classmap": [
            "src/Data/Api.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Bentonow\\ShibaLaravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --compact",
        "test:affected": "vendor/bin/pest --compact --parallel --tia --filtered --baselined",
        "test:full": "vendor/bin/pest --compact",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --level=5 --memory-limit=1G src"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bentonow\\ShibaLaravel\\ShibaServiceProvider"
            ]
        }
    }
}
